+			}
+		}
+		private static void mergeText(Map<String, SupportText> target, List<SupportText> values) throws IOException {
+			for (SupportText value : values) {
+				SupportText previous = target.putIfAbsent(value.key(), value);
+				if (previous != null && !previous.equals(value)) { throw new IOException("Conflicting callable support: " + value.key()); }
+			}
+		}
+		private String readBody(StoredBody body) throws IOException {
+			byte[] bytes = new byte[body.length()]; spool.seek(body.offset()); spool.readFully(bytes);
+			return new String(bytes, StandardCharsets.UTF_8);
+		}
+		private static BodyId targetOf(String key) throws IOException {
+			String[] parts = key.split("_", 5);
+			try {
+				if (parts.length != 5 || !parts[0].equals("kuna") || !parts[1].equals("entry") || parts[4].isEmpty()) {
+					throw new NumberFormatException();
+				}
+				return new BodyId(Integer.parseInt(parts[2]), Long.parseUnsignedLong(parts[3]));
+			}
+			catch (NumberFormatException e) { throw new IOException("Invalid callable key: " + key, e); }
+		}
+		private static boolean isQualifiedProof(String key, String providerKey) {
+			String prefix = providerKey + "_internal_";
+			if (providerKey.contains("_internal_") || !key.startsWith(prefix)) { return false; }
+			String[] role = key.substring(prefix.length()).split("_", -1);
+			if (role.length != 3) { return false; }
+			try {
+				int space = Integer.parseInt(role[0]);
+				long address = Long.parseUnsignedLong(role[1]);
+				int size = Integer.parseInt(role[2]);
+				return space >= 0 && size > 0 && Long.compareUnsigned(address + size, address) > 0 &&
+					role[0].equals(Integer.toString(space)) &&
+					role[1].equals(Long.toUnsignedString(address)) && role[2].equals(Integer.toString(size));
+			}
+			catch (NumberFormatException e) { return false; }
+		}
+		public void validate() throws IOException {
+			if (validated) { return; }
+			Map<BodyId, List<Edge>> edges = new LinkedHashMap<>();
+			for (var entry : bodies.entrySet()) {
+				edges.put(entry.getKey(), new ArrayList<>());
+				Set<String> localKeys = new HashSet<>();
+				for (Artifact artifact : entry.getValue().artifacts()) {
+					if (!localKeys.add(artifact.key())) { throw new IOException("Duplicate owner-local callable key"); }
+					String prior = declarations.putIfAbsent(artifact.key(), artifact.declaration());
+					if (prior != null && !prior.equals(artifact.declaration())) { throw new IOException("Conflicting callable declaration"); }
+					if (artifact.kind() != DefinitionKind.NONE) {
+						if (!targetOf(artifact.key()).equals(entry.getKey())) { throw new IOException("Callable definition has wrong owning body"); }
+						if (artifact.kind() == DefinitionKind.EXISTING &&
+								!artifact.declaration().equals(entry.getValue().declaration())) {
+							throw new IOException("Existing callable declaration differs from its actual body ABI");
+						}
+						Provider previous = providers.putIfAbsent(artifact.key(), new Provider(entry.getKey(), artifact));
+						if (previous != null) { throw new IOException("Callable key has multiple owning bodies"); }
+					}
+				}
+			}
+			for (Provider provider : providers.values()) {
+				Artifact proof = provider.artifact();
+				if (proof.kind() != DefinitionKind.BODYPROOF) { continue; }
+				Provider concrete = providers.get(proof.providerKey());
+				if (concrete == null ||
+						(concrete.artifact().kind() != DefinitionKind.WRAPPER &&
+						 concrete.artifact().kind() != DefinitionKind.EXISTING) ||
+						!provider.owner().equals(concrete.owner()) ||
+						!proof.declaration().equals(concrete.artifact().declaration()) ||
+						!isQualifiedProof(proof.key(), proof.providerKey())) {
+					throw new IOException("Callable body proof lacks its exact concrete provider: " + proof.key());
+				}
+			}
+			for (var entry : bodies.entrySet()) {
+				for (Artifact artifact : entry.getValue().artifacts()) {
+					if (!artifact.required()) { continue; }
+					Provider provider = providers.get(artifact.key());
+					if (provider == null) { throw new IOException("Missing actual callable provider: " + artifact.key()); }
+					if (provider.artifact().kind() == DefinitionKind.BODYPROOF && !artifact.deferred()) {
+						throw new IOException("Required callable body proof must retain its deferred assumption: " + artifact.key());
+					}
+					edges.get(entry.getKey()).add(new Edge(provider.owner(), artifact.deferred()));
+				}
+			}
+			checkDeferredComponents(edges);
+			validated = true;
+		}
+		private static void checkDeferredComponents(Map<BodyId, List<Edge>> edges) throws IOException {
+			Map<BodyId, List<BodyId>> reverse = new HashMap<>();
+			for (BodyId id : edges.keySet()) { reverse.put(id, new ArrayList<>()); }
+			for (var entry : edges.entrySet()) { for (Edge edge : entry.getValue()) { reverse.get(edge.target()).add(entry.getKey()); } }
+			Set<BodyId> seen = new HashSet<>(); List<BodyId> order = new ArrayList<>();
+			Deque<BodyId> nodes = new ArrayDeque<>(); Deque<Iterator<Edge>> cursors = new ArrayDeque<>();
+			for (BodyId root : edges.keySet()) {
+				if (!seen.add(root)) { continue; }
+				nodes.push(root); cursors.push(edges.get(root).iterator());
+				while (!nodes.isEmpty()) {
+					if (cursors.peek().hasNext()) {
+						BodyId next = cursors.peek().next().target();
+						if (seen.add(next)) { nodes.push(next); cursors.push(edges.get(next).iterator()); }
+					}
+					else { order.add(nodes.pop()); cursors.pop(); }
+				}
+			}
+			Map<BodyId, Integer> component = new HashMap<>(); int number = 0;
+			for (int i = order.size() - 1; i >= 0; --i) {
+				BodyId root = order.get(i); if (component.containsKey(root)) { continue; }
+				component.put(root, number); nodes.push(root);
+				while (!nodes.isEmpty()) {
+					for (BodyId next : reverse.get(nodes.pop())) {
+						if (component.putIfAbsent(next, number) == null) { nodes.push(next); }
+					}
+				}
+				++number;
+			}
+			for (var entry : edges.entrySet()) { for (Edge edge : entry.getValue()) {
+				if (edge.deferred() && component.get(entry.getKey()).equals(component.get(edge.target()))) {
+					throw new IOException("Deferred callable assumption participates in a body cycle");
+				}
+			} }
+		}
+		/** Authenticate exact source revisions before excluding any Program definition. */
+		public Predicate<DataType> sourceOwnership(PcodeDataTypeManager manager) throws IOException {
+			if (!validated) { throw new IOException("Callable publication is not finalized"); }
+			Set<DataType> programRoots = Collections.newSetFromMap(new IdentityHashMap<>());
+			Map<Long, SourceIdentity> builtins = new HashMap<>();
+			Map<String, SourceIdentity> identities = new HashMap<>();
+			Map<SourceIdentity, SupportText> sourceOwners = new HashMap<>();
+			long revision = manager.getProgram().getModificationNumber();
+			for (Map<String, SupportText> group : List.of(prelude, types)) {
+				for (SupportText text : group.values()) { for (SourceIdentity source : text.sources()) {
+					if (source.program() != manager.getProgram().getUniqueProgramID() ||
+							(!source.kind().equals("builtin") && source.revision() != revision)) {
+						throw new IOException("Stale callable source revision");
+					}
+					String key = source.kind() + ':' + source.scope() + ':' + Long.toUnsignedString(source.id());
+					SourceIdentity prior = identities.putIfAbsent(key, source);
+					if (prior != null && !prior.equals(source)) { throw new IOException("Conflicting sized source identities"); }
+					SupportText priorOwner = sourceOwners.putIfAbsent(source, text);
+					if (priorOwner != null && !priorOwner.equals(text)) {
+						throw new IOException("Source identity has conflicting definition owners");
+					}
+					if (source.kind().equals("program")) {
+						DataType root = manager.getProgram().getDataTypeManager().getDataType(source.id());
+						if (root == null || !manager.getSourceIdentity(root, source.size()).equals(source)) { throw new IOException("Source receipt does not identify the Program root"); }
+						programRoots.add(root);
+					}
+					else if (source.kind().equals("builtin")) {
+						DataType root = manager.findBaseType("", source.id());
+						if (root == null || !sameBuiltin(source, manager.getSourceIdentity(root, source.size()))) {
+							throw new IOException("Builtin source layout no longer matches the actual producer");
+						}
+						builtins.put(source.id(), source);
+					}
+				} }
+			}
+			return type -> {
+				if (manager.getProgram().getModificationNumber() != revision) {
+					throw new IllegalStateException("Program changed during callable source publication");
+				}
+				if (programRoots.contains(type)) { return true; }
+				if (!(type instanceof ghidra.program.model.data.BuiltIn ||
+						type instanceof ghidra.program.model.data.DefaultDataType)) { return false; }
+				SourceIdentity owned = builtins.get(manager.getEncodedTypeId(type));
+				return owned != null && sameBuiltin(owned,
+					manager.getSourceIdentity(type, owned.size()));
+			};
+		}
+		private static boolean sameBuiltin(SourceIdentity old, SourceIdentity current) {
+			return old.kind().equals("builtin") && current.kind().equals("builtin") &&
+				old.program() == current.program() && old.id() == current.id() &&
+				old.size() == current.size() && old.scope().equals(current.scope()) &&
+				!old.binding().isEmpty() && old.binding().equals(current.binding());
+		}
+		private void ready() throws IOException { if (!validated) { throw new IOException("Callable publication is not finalized"); } }
+		public void writeTypes(Writer output) throws IOException {
+			ready(); for (SupportText value : prelude.values()) { output.write(value.text()); output.write('\n'); }
+			for (SupportText value : types.values()) { output.write(value.text()); output.write('\n'); }
+		}
+		public void writeDeclarations(Writer output, boolean emitGlobals) throws IOException {
+			ready(); if (emitGlobals) { for (SupportText value : globals.values()) { output.write(value.text()); output.write('\n'); } }
+			for (StoredBody body : bodies.values()) { output.write(body.declaration()); output.write('\n'); }
+			for (var entry : declarations.entrySet()) {
+				Provider provider = providers.get(entry.getKey());
+				if (provider != null && (provider.artifact().kind() == DefinitionKind.EXISTING ||
+						provider.artifact().kind() == DefinitionKind.BODYPROOF)) { continue; }
+				output.write(entry.getValue()); output.write('\n');
+			}
+		}
+		public void writeBodies(Writer output) throws IOException {
+			ready(); for (Provider provider : providers.values()) {
+				if (provider.artifact().kind() == DefinitionKind.WRAPPER) { output.write(provider.artifact().definition()); output.write('\n'); }
+			}
+			for (StoredBody body : bodies.values()) { output.write(readBody(body)); output.write('\n'); }
+		}
+		public void writeLegacyHeaders(Writer output) throws IOException {
+			ready(); output.write(legacyHeaders.toString());
+		}
+		public void writeLegacyBodies(Writer output, boolean emitGlobals) throws IOException {
+			ready();
+			if (emitGlobals) { for (String global : legacyGlobals) { output.write(global); output.write('\n'); } }
+			for (StoredFragment fragment : legacyBodies) {
+				byte[] bytes = new byte[fragment.length()]; spool.seek(fragment.offset()); spool.readFully(bytes);
+				output.write(new String(bytes, StandardCharsets.UTF_8)); output.write('\n');
+			}
+		}
+		@Override public void close() throws IOException {
+			try { spool.close(); } finally { Files.deleteIfExists(path); }
+		}
+	}
+}
