--- a/ghidra/app/util/bin/format/dwarf/DWARFDataTypeImporter.java
+++ b/ghidra/app/util/bin/format/dwarf/DWARFDataTypeImporter.java
@@ -407,6 +407,28 @@
 
 		// Find the type the 'const' is applied to and transparently return it instead of ourselves.
 		DWARFDataType refdDT = getDataType(diea.getTypeRef(), voidDDT);
+		DWARFCompilationUnit cu = diea.getCompilationUnit();
+		String producer = cu.getProducer();
+		int language = cu.getLanguage();
+		boolean gnuC = producer != null && producer.startsWith("GNU ") &&
+			(language == DWARFSourceLanguage.DW_LANG_C ||
+				language == DWARFSourceLanguage.DW_LANG_C89 ||
+				language == DWARFSourceLanguage.DW_LANG_C99 ||
+				language == DWARFSourceLanguage.DW_LANG_C11);
+		if (diea.getTag() == DW_TAG_volatile_type && gnuC &&
+			refdDT.dataType instanceof FunctionDefinition signature) {
+			// GCC emits attribute((noreturn)) as qualification of the function
+			// itself. Do not erase that supplied effect, and do not mutate the
+			// shared may-return definition used by an unqualified callback.
+			DWARFName name = prog.getName(diea);
+			FunctionDefinitionDataType qualified = new FunctionDefinitionDataType(
+				name.getParentCP(), name.getName(), signature, dataTypeManager);
+			qualified.setNoReturn(true);
+			if (name.isAnon()) {
+				DataTypeNamingUtil.setMangledAnonymousFunctionName(qualified);
+			}
+			return new DWARFDataType(qualified, name, diea.getOffset());
+		}
 		refdDT.offsets.add(diea.getOffset());
 
 		return refdDT;
