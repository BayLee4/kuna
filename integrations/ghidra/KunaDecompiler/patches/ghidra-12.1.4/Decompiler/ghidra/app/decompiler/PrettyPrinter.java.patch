+	private String getTypedText(ClangNode node) {
+		if (node instanceof ClangToken token) {
+			String text = getTokenText(token, typeNames);
+			if (token instanceof ClangTypeToken || token instanceof ClangFuncNameToken ||
+				token instanceof ClangVariableToken || token instanceof ClangFieldToken ||
+				token instanceof ClangLabelToken) {
