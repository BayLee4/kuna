+		}
+		StringBuilder buffer = new StringBuilder();
+		for (int i = 0; i < node.numChildren(); i++) {
+			String text = getTypedText(node.Child(i));
+			if (text.isEmpty()) {
+				continue;
+			}
+			if (buffer.length() != 0 && isNameCharacter(buffer.charAt(buffer.length() - 1)) &&
+				isNameCharacter(text.charAt(0))) {
