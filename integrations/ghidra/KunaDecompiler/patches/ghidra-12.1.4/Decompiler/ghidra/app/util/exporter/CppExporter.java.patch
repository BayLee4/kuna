+	private static void reserveSourceNames(List<CPPResult> results, ExportDataTypeNames typeNames,
+			TaskMonitor monitor) throws CancelledException {
+		for (CPPResult result : results) {
+			monitor.checkCancelled();
+			if (result != null && result.result() != null) {
+				if (result.result().isEnhancedResult()) {
+					result.result().requireCurrentExportAuthority();
+				}
+				typeNames.reserveSources(result.result(), monitor);
+			}
+		}
+	}
