+	private void writeExternalDeclarations(ExportDataTypeNames typeNames,
+			DataTypeWriter typeWriter, DataTypeWriter declarations, PrintWriter writer,
+			Set<String> processedGlobals, TaskMonitor monitor) throws IOException, CancelledException {
+		for (var external : typeNames.externalFunctions()) {
+			monitor.checkCancelled();
+			if (writer != null) {
+				String label = external.importedName();
+				StringBuilder escaped = new StringBuilder();
+				for (int i = 0; i < label.length(); i++) {
+					char ch = label.charAt(i);
+					if (ch == '\\' || ch == '"') {
+						escaped.append('\\');
+					}
+					escaped.append(ch);
+				}
+				String declaration = "extern " +
+					(external.signature().hasNoReturn() ? "_Noreturn " : "") +
+					declarations.getDeclaration(external.name(),
+					external.signature(), -1, monitor) + " __asm__(\"" + escaped + "\");";
+				if (processedGlobals.add(declaration)) {
+					if (typeWriter != null) {
+						typeWriter.write(List.of(external.signature()), monitor, true);
+					}
+					writer.println(declaration);
+				}
+			}
+		}
+	}
