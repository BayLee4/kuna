+	/**
+	 * Acquires exactly the explicit roots before an enhanced caller discovers derived providers.
+	 * The returned results retain their typed views. The same invocation configuration is used
+	 * by export's pooled interfaces; this method does not widen selection or modify source facts.
+	 */
+	public List<DecompileResults> prepareSelectedRoots(Program program,
+			Collection<Function> roots, TaskMonitor monitor) throws IOException, CancelledException {
+		monitor.checkCancelled();
+		configureOptions(program);
+		DecompilerFactory factory = new DecompilerFactory(program, configurer, true, null);
+		DecompInterface decompiler = factory.doCreate(0);
+		try {
+			List<DecompileResults> results = new ArrayList<>();
+			for (Function function : roots) {
+				monitor.checkCancelled();
+				if (function.getProgram() != program) {
+					throw new IllegalArgumentException("Export root belongs to another program");
+				}
+				results.add(decompiler.decompileFunction(function, options.getDefaultTimeout(),
+					monitor));
+			}
+			return results;
+		}
+		finally {
+			factory.doDispose(decompiler);
+		}
+	}
