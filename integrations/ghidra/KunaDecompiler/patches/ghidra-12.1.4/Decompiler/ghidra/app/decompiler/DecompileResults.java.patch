+	private ExportBinding decodeExportBinding(Decoder decoder) throws DecoderException {
+		int root = decoder.openElement(ELEM_KUNA_EXPORT);
+		String sourceName = decoder.readString(ATTRIB_NAME);
+		String implementationName = decoder.readString(ATTRIB_CONTENT);
+		boolean privateImplementation = decoder.readBool(ATTRIB_KUNA_PRIVATE);
+		int publicIndex = Math.toIntExact(decoder.readSignedInteger(ATTRIB_KUNA_PUBLIC));
+		if (sourceName.isEmpty() || implementationName.isEmpty() || publicIndex < -1) {
+			throw new DecoderException("Invalid export publication identity");
+		}
+		int addressElement = decoder.openElement(ELEM_ADDR);
+		AddressSpace space = decoder.readSpace(ATTRIB_SPACE);
+		long offset = decoder.readUnsignedInteger(ATTRIB_OFFSET);
+		if (space == null) {
+			throw new DecoderException("Missing export entry address space");
+		}
+		Address entry = space.getAddress(offset);
+		decoder.closeElement(addressElement);
+		if (!entry.equals(function.getEntryPoint())) {
+			throw new DecoderException("Export publication entry does not match the function");
+		}
+		List<ExportDeclaration> declarations = new ArrayList<>();
+		Set<Integer> indices = new HashSet<>();
+		while (decoder.peekElement() != 0) {
+			int child = decoder.openElement(ELEM_KUNA_EXPORT_DECL);
+			int index = Math.toIntExact(decoder.readUnsignedInteger(ATTRIB_INDEX));
+			String name = decoder.readString(ATTRIB_NAME);
+			String role = decoder.readString(ATTRIB_CONTENT);
+			if (index < 0 || name.isEmpty() || !indices.add(index) ||
+				!(role.equals("public") || role.equals("implementation") ||
+					role.equals("dependency") || role.equals("helper"))) {
+				throw new DecoderException("Invalid or duplicate export declaration");
+			}
+			declarations.add(new ExportDeclaration(index, name, role));
+			decoder.closeElement(child);
+		}
+		decoder.closeElement(root);
+		return new ExportBinding(sourceName, implementationName, privateImplementation,
+			publicIndex, entry, declarations, null);
+	}
+
+	private ExportBinding bindExportMarkup(ExportBinding binding) throws DecoderException {
+		if (hfunc == null || docroot == null) {
+			throw new DecoderException("Export publication requires complete High and C markup");
+		}
+		List<ClangFuncProto> prototypes = new ArrayList<>();
+		collectExportPrototypes(docroot, prototypes);
+		if (binding.publicPrototypeIndex >= prototypes.size()) {
+			throw new DecoderException("Export public prototype index is out of range");
+		}
+		boolean foundPublic = false;
+		boolean foundImplementation = false;
+		for (ExportDeclaration declaration : binding.declarations) {
+			if (declaration.index >= prototypes.size()) {
+				throw new DecoderException("Export declaration index is out of range");
+			}
+			if (!declaration.name.equals(findExportFunctionName(prototypes.get(declaration.index)))) {
+				throw new DecoderException("Export declaration does not match typed markup");
+			}
+			if (declaration.role.equals("public")) {
+				if (foundPublic || declaration.index != binding.publicPrototypeIndex ||
+					!declaration.name.equals(binding.sourceName)) {
+					throw new DecoderException("Export public declaration does not match publication");
+				}
+				foundPublic = true;
+			}
+			if (declaration.role.equals("implementation")) {
+				if (foundImplementation || !declaration.name.equals(binding.implementationName)) {
+					throw new DecoderException("Export implementation declaration does not match publication");
+				}
+				foundImplementation = true;
+			}
+		}
+		if (foundPublic != (binding.publicPrototypeIndex >= 0) ||
+			binding.privateImplementation && !foundImplementation) {
+			throw new DecoderException("Missing export publication declaration");
+		}
+		ClangFuncProto publicPrototype = binding.publicPrototypeIndex < 0 ? null :
+			prototypes.get(binding.publicPrototypeIndex);
+		return new ExportBinding(binding.sourceName, binding.implementationName,
+			binding.privateImplementation, binding.publicPrototypeIndex, binding.entry,
+			binding.declarations, publicPrototype);
+	}
+
+	private static void collectExportPrototypes(ClangNode node, List<ClangFuncProto> prototypes) {
+		if (node instanceof ClangFuncProto prototype) {
+			prototypes.add(prototype);
+		}
+		for (int i = 0; i < node.numChildren(); i++) {
+			collectExportPrototypes(node.Child(i), prototypes);
+		}
+	}
+
+	private static String findExportFunctionName(ClangNode node) {
+		if (node instanceof ClangFuncNameToken token) {
+			return token.getText();
+		}
+		for (int i = 0; i < node.numChildren(); i++) {
+			String name = findExportFunctionName(node.Child(i));
+			if (name != null) {
+				return name;
+			}
+		}
+		return null;
 	}
 
