+			this.sourceName = sourceName;
+			this.implementationName = implementationName;
+			this.privateImplementation = privateImplementation;
+			this.publicPrototypeIndex = publicPrototypeIndex;
+			this.entry = entry;
+			this.declarations = List.copyOf(declarations);
+			this.publicPrototype = publicPrototype;
+			Set<String> names = new LinkedHashSet<>();
+			names.add(sourceName);
+			names.add(implementationName);
+			for (ExportDeclaration declaration : declarations) {
+				names.add(declaration.name);
+			}
+			declarationNames = List.copyOf(names);
