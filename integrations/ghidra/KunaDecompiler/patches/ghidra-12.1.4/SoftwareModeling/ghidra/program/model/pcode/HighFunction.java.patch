+	private int getOverrideFirstVarArg(Program program, Address address,
+			FunctionSignature signature) {
+		int effectiveFirst = HighFunctionDBUtil.getFirstVarArg(program, address);
+		if (effectiveFirst <= 0) {
+			return effectiveFirst;
+		}
+		Function referenced = null;
+		for (Reference reference : program.getReferenceManager().getReferencesFrom(address)) {
+			if (reference.isPrimary() && reference.getReferenceType().isCall()) {
+				referenced = program.getFunctionManager().getFunctionAt(reference.getToAddress());
+				break;
+			}
+		}
+		PrototypeModel model = compilerSpec.getCallingConvention(signature.getCallingConventionName());
+		if (referenced == null || !referenced.hasVarArgs() || referenced.hasCustomVariableStorage() ||
+				referenced.getParameterCount() != effectiveFirst || model == null ||
+				model != referenced.getCallingConvention() || model.isMerged() ||
+				model.hasThisPointer() || model.hasInjection() ||
+				!signature.getReturnType().isEquivalent(referenced.getReturn().getFormalDataType())) {
+			return effectiveFirst;
+		}
+		Parameter[] fixed = referenced.getParameters();
+		int logicalFirst = 0;
+		int hidden = 0;
+		var arguments = signature.getArguments();
+		for (Parameter parameter : fixed) {
+			if (parameter.isAutoParameter()) {
+				if (parameter.getAutoParameterType() != AutoParameterType.RETURN_STORAGE_PTR) {
+					return effectiveFirst;
+				}
+				++hidden;
+			}
+			else {
+				if (parameter.isForcedIndirect() || logicalFirst >= arguments.length ||
+						!arguments[logicalFirst].getDataType().isEquivalent(parameter.getFormalDataType())) {
+					return effectiveFirst;
+				}
+				++logicalFirst;
+			}
+		}
+		if (hidden != 1 || logicalFirst <= 0 || logicalFirst + hidden != effectiveFirst) {
+			return effectiveFirst;
+		}
+		PrototypePieces pieces = new PrototypePieces(model, signature.getReturnType());
+		for (var argument : arguments) {
+			pieces.intypes.add(argument.getDataType());
+		}
+		pieces.firstVarArgSlot = logicalFirst;
+		ArrayList<ParameterPieces> allocated = new ArrayList<>();
+		model.assignParameterStorage(pieces, program.getDataTypeManager(), allocated, true);
+		if (allocated.size() != arguments.length + hidden + 1 || !allocated.get(0).isIndirect ||
+				allocated.get(0).joinPieces != null) {
+			return effectiveFirst;
+		}
+		for (int index = 1; index < allocated.size(); ++index) {
+			ParameterPieces piece = allocated.get(index);
+			if (piece.isThisPointer || piece.isIndirect || piece.joinPieces != null ||
+					piece.address == null || piece.address == Address.NO_ADDRESS) {
+				return effectiveFirst;
+			}
+			if (index <= effectiveFirst) {
+				Parameter original = fixed[index - 1];
+				Varnode[] storage = original.getVariableStorage().getVarnodes();
+				if (piece.hiddenReturnPtr != original.isAutoParameter() || storage.length != 1 ||
+						!storage[0].getAddress().equals(piece.address) ||
+						storage[0].getSize() != piece.type.getLength()) {
+					return effectiveFirst;
+				}
+			}
+			else if (piece.hiddenReturnPtr) {
+				return effectiveFirst;
+			}
+		}
+		return logicalFirst;
+	}
