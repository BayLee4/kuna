+	private static void requireSourceDatatype(HighFunction highFunction, DataType type)
+			throws InvalidInputException {
+		if (!highFunction.getDataTypeManager().isEnhancedResult() || type == null) {
+			return;
+		}
+		Set<DataType> visited = Collections.newSetFromMap(new IdentityHashMap<>());
+		if (containsResultLocal(highFunction.getDataTypeManager(), type, visited)) {
+			throw new InvalidInputException(
+				"Result-local inferred datatypes require explicit source authoring");
+		}
+	}
+
+	private static boolean containsResultLocal(PcodeDataTypeManager manager, DataType type,
+			Set<DataType> visited) {
+		if (type == null || !visited.add(type)) {
+			return false;
+		}
+		if (manager.isResultLocal(type)) {
+			return true;
+		}
+		if (type instanceof Pointer pointer) {
+			return containsResultLocal(manager, pointer.getDataType(), visited);
+		}
+		if (type instanceof Array array) {
+			return containsResultLocal(manager, array.getDataType(), visited);
+		}
+		if (type instanceof TypeDef alias) {
+			return containsResultLocal(manager, alias.getDataType(), visited);
+		}
+		if (type instanceof BitFieldDataType bitfield) {
+			return containsResultLocal(manager, bitfield.getBaseDataType(), visited);
+		}
+		if (type instanceof Composite composite) {
+			for (DataTypeComponent component : composite.getDefinedComponents()) {
+				if (containsResultLocal(manager, component.getDataType(), visited)) {
+					return true;
+				}
+			}
+		}
+		if (type instanceof FunctionDefinition callable) {
+			if (containsResultLocal(manager, callable.getReturnType(), visited)) {
+				return true;
+			}
+			for (ParameterDefinition parameter : callable.getArguments()) {
+				if (containsResultLocal(manager, parameter.getDataType(), visited)) {
+					return true;
+				}
+			}
+		}
+		return false;
+	}
