+		requireSourceAuthority(high, type);
+		if (commitParameters) {
+			requireParameterDatatypes(high, true, ReturnCommitOption.NO_COMMIT);
+		}
+		DataTypeManager manager = high.getFunction().getProgram().getDataTypeManager();
+		if (type.getDataTypeManager() != manager) {
+			type = manager.resolve(type, null);
+		}
+		if (commitParameters) {
+			commitParametersForRetype(high, true, source);
+		}
+		high.getFunction().setReturnType(type, source);
+	}
