+			requireParameterDatatypes(high, useDataTypes, ReturnCommitOption.NO_COMMIT);
+		}
+		boolean retype = dataType != null;
+		if (dataType != null) {
+			DataTypeManager manager = high.getFunction().getProgram().getDataTypeManager();
+			if (dataType.getDataTypeManager() != manager) {
+				dataType = manager.resolve(dataType, null);
+			}
+		}
+		if (commitParameters) {
+			if (retype) {
+				commitParametersForRetype(high, useDataTypes, signatureSource);
+			}
+			else {
+				commitParamsFromGrantedSource(high, useDataTypes, ReturnCommitOption.NO_COMMIT,
+					signatureSource);
+			}
+		}
+		updateDBVariableFromGrantedSource(highSymbol, name, dataType, source);
+	}
