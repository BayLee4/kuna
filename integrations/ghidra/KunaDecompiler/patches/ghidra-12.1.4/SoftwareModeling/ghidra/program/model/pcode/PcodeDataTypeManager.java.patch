+	private DataType resolveResultType(ResultTypeNode node,
+			Map<Long, ResultTypeDefinition> definitions) throws DecoderException {
+		if (node.local != 0) {
+			ResultTypeDefinition definition = definitions.get(node.local);
+			if (definition == null) {
+				throw new DecoderException("Unreserved result datatype reference " + node.local);
+			}
+			return completeResultType(definition, definitions);
+		}
+		if (node.element == ELEM_VOID.id()) {
+			return voidDt;
+		}
+		if (node.element == ELEM_QUALIFIED.id()) {
+			return new ResultQualifiedDataType("qualified",
+				resolveResultType(node.typeChild(), definitions),
+				Math.toIntExact(node.value), progDataTypes);
+		}
+		if (!node.name.isEmpty() || node.element == ELEM_TYPEREF.id()) {
+			DataType type = findBaseType(node.name, node.id);
+			if (type == null) {
+				throw new DecoderException("Unresolved host datatype " + node.name);
+			}
+			return type;
+		}
+		return createResultLeaf(node, definitions);
+	}
+
+	private DataType createResultLeaf(ResultTypeNode node,
+			Map<Long, ResultTypeDefinition> definitions) throws DecoderException {
+		switch (node.meta) {
+			case "ptr":
+				boolean useDefaultSize = (node.size == dataOrganization.getPointerSize() ||
+					node.size > PointerDataType.MAX_POINTER_SIZE_BYTES);
+				return new PointerDataType(resolveResultType(node.typeChild(), definitions),
+					useDefaultSize ? -1 : node.size, progDataTypes);
+			case "ptrrel":
+				if (node.children.size() != 3 || node.child(ELEM_OFF.id()) == null) {
+					throw new DecoderException("Invalid result relative pointer");
+				}
+				return new PointerTypedef(node.name.isEmpty() ? null : node.name,
+					resolveResultType(node.children.get(1), definitions), node.size,
+					progDataTypes, node.child(ELEM_OFF.id()).value);
+			case "array":
+				DataType element = resolveResultType(node.typeChild(), definitions);
+				return new ArrayDataType(element, node.count, element.getLength(), progDataTypes);
+			case "int":
+				return AbstractIntegerDataType.getSignedDataType(node.size, progDataTypes)
+						.copy(progDataTypes);
+			case "uint":
+				return AbstractIntegerDataType.getUnsignedDataType(node.size, progDataTypes)
+						.copy(progDataTypes);
+			case "float":
+				return AbstractFloatDataType.getFloatDataType(node.size, progDataTypes)
+						.copy(progDataTypes);
+			case "bool":
+				return BooleanDataType.dataType.copy(progDataTypes);
+			case "code":
+				// A genuinely unknown executable type has no callable facts to invent.
+				DataType unknownCode = new Undefined1DataType(progDataTypes);
+				return node.name.isEmpty() ? unknownCode :
+					new TypedefDataType(CategoryPath.ROOT, node.name, unknownCode, progDataTypes);
+			case "void":
+			case "spacebase":
+				return new VoidDataType(progDataTypes);
+			case "partunion":
+				return new PartialUnion(progDataTypes,
+					resolveResultType(node.typeChild(), definitions), node.offset, node.size);
+			case "partstruct":
+			case "partenum":
+				return new ResultPartialDataType(progDataTypes,
+					resolveResultType(node.typeChild(), definitions), node.offset, node.size, node.meta);
+			case "unknown":
+				return Undefined.getUndefinedDataType(node.size).copy(progDataTypes);
+			default:
+				throw new DecoderException("Unsupported result datatype metatype " + node.meta);
+		}
+	}
