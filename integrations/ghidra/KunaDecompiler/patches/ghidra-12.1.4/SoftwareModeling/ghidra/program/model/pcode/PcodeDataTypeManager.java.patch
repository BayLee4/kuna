+	private static ResultTypeNode readResultTypeNode(Decoder decoder) throws DecoderException {
+		ResultTypeNode node = new ResultTypeNode();
+		node.element = decoder.openElement();
+		for (int attr; (attr = decoder.getNextAttributeId()) != 0;) {
+			if (attr == ATTRIB_NAME.id()) {
+				node.name = decoder.readString();
+			}
+			else if (attr == ATTRIB_METATYPE.id()) {
+				node.meta = decoder.readString();
+			}
+			else if (attr == ATTRIB_MODEL.id()) {
+				node.model = decoder.readString();
+			}
+			else if (attr == ATTRIB_ID.id()) {
+				if (node.element == ELEM_TYPE.id() || node.element == ELEM_TYPEREF.id() ||
+					node.element == ELEM_DEF.id() || node.element == ELEM_KUNA_TYPE.id()) {
+					node.id = decoder.readUnsignedInteger();
+				}
+			}
+			else if (attr == ATTRIB_KUNA_LOCAL.id()) {
+				node.local = decoder.readUnsignedInteger();
+			}
+			else if (attr == ATTRIB_SIZE.id()) {
+				node.size = Math.toIntExact(decoder.readSignedInteger());
+			}
+			else if (attr == ATTRIB_ARRAYSIZE.id()) {
+				node.count = Math.toIntExact(decoder.readSignedInteger());
+			}
+			else if (attr == ATTRIB_OFFSET.id() && node.element != ELEM_ADDR.id()) {
+				node.offset = Math.toIntExact(decoder.readSignedInteger());
+			}
+			else if (attr == ATTRIB_FIRST.id()) {
+				node.first = Math.toIntExact(decoder.readSignedInteger());
+			}
+			else if (attr == ATTRIB_VALUE.id()) {
+				node.value = node.element == ELEM_QUALIFIED.id() ?
+					decoder.readUnsignedInteger() : decoder.readSignedInteger();
+			}
+			else if (attr == ATTRIB_CONTENT.id() && node.element == ELEM_OFF.id()) {
+				node.value = decoder.readSignedInteger();
+			}
+			else if (attr == ATTRIB_DOTDOTDOT.id()) {
+				node.varargs = decoder.readBool();
+			}
+			else if (attr == ATTRIB_NORETURN.id()) {
+				node.noreturn = decoder.readBool();
+			}
+		}
+		while (decoder.peekElement() != 0) {
+			node.children.add(readResultTypeNode(decoder));
+		}
+		decoder.closeElement(node.element);
+		return node;
+	}
