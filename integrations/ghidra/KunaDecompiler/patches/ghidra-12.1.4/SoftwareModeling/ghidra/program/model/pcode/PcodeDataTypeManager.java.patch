+	private DataType completeResultType(ResultTypeDefinition definition,
+			Map<Long, ResultTypeDefinition> definitions) throws DecoderException {
+		if (definition.complete || definition.resolving) {
+			if (definition.type == null) {
+				throw new DecoderException("Result datatype cycle has no nominal owner");
+			}
+			return definition.type;
+		}
+		definition.resolving = true;
+		ResultTypeNode body = definition.body;
+		DataType type = definition.type;
+		try {
+			if (type instanceof TypeDef) {
+				TypeDef alias = (TypeDef) type;
+				type.dataTypeReplaced(alias.getDataType(),
+					resolveResultType(body.typeChild(), definitions));
+			}
+			else if (type instanceof Composite) {
+				for (ResultTypeNode field : body.children) {
+					if (field.element != ELEM_FIELD.id() && field.element != ELEM_BITFIELD.id()) {
+						throw new DecoderException("Unexpected result composite member");
+					}
+					ResultTypeNode memberRecord = field.typeChild();
+					DataType member = resolveResultType(memberRecord, definitions);
+					int memberLength = memberRecord.size > 0 ? memberRecord.size : member.getLength();
+					if (type instanceof Structure) {
+						Structure structure = (Structure) type;
+						if (field.element == ELEM_BITFIELD.id()) {
+							structure.insertBitFieldAt(field.offset, member.getLength(), field.first,
+								member, field.size, field.name, null);
+						}
+						else {
+							structure.replaceAtOffset(field.offset, member, memberLength,
+								field.name, null);
+						}
+					}
+					else if (field.element == ELEM_BITFIELD.id()) {
+						((Union) type).addBitField(member, field.size, field.name, null);
+					}
+					else {
+						((Union) type).add(member, memberLength, field.name, null);
+					}
+				}
+			}
+			else if (type instanceof Enum) {
+				for (ResultTypeNode value : body.children) {
+					if (value.element != ELEM_VAL.id()) {
+						throw new DecoderException("Unexpected result enumeration member");
+					}
+					((Enum) type).add(value.name, value.value);
+				}
+			}
+			else if (type instanceof FunctionDefinition) {
+				ResultTypeNode prototype = body.child(ELEM_PROTOTYPE.id());
+				if (prototype == null || prototype.child(ELEM_RETURNSYM.id()) == null) {
+					throw new DecoderException("Missing result callable prototype");
+				}
+				FunctionDefinition function = (FunctionDefinition) type;
+				function.setReturnType(resolveResultType(
+					prototype.child(ELEM_RETURNSYM.id()).typeChild(), definitions));
+				List<ParameterDefinition> parameters = new ArrayList<>();
+				ResultTypeNode inputs = prototype.child(ELEM_INTERNALLIST.id());
+				if (inputs != null) {
+					for (ResultTypeNode parameter : inputs.children) {
+						if (parameter.element == ELEM_RETPARAM.id()) {
+							continue; // The canonical codec repeats the result in its internal store.
+						}
+						if (parameter.element != ELEM_PARAM.id()) {
+							throw new DecoderException("Unexpected result callable parameter");
+						}
+						parameters.add(new ParameterDefinitionImpl(parameter.name,
+							resolveResultType(parameter.typeChild(), definitions), null));
+					}
+				}
+				function.setArguments(parameters.toArray(new ParameterDefinition[0]));
+				function.setVarArgs(prototype.varargs);
+				function.setNoReturn(prototype.noreturn);
+				function.setCallingConvention(prototype.model);
+			}
+			else {
+				type = body.element == ELEM_VOID.id() ? new VoidDataType(progDataTypes) :
+					createResultLeaf(body, definitions);
+			}
+		}
+		catch (ghidra.util.exception.InvalidInputException | InvalidDataTypeException e) {
+			throw new DecoderException("Invalid result datatype: " + e.getMessage());
+		}
+		definition.type = type;
+		definition.complete = true;
+		definition.resolving = false;
+		return type;
+	}
 
