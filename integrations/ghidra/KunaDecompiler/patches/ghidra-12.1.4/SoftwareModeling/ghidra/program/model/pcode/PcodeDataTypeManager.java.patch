+	/**
+	 * Admit version 1 only at the DOC boundary. Reservations and definitions are separate so
+	 * every recursive composite, alias, and callable has its final Java identity before descent.
+	 */
+	public void decodeResultPrelude(Decoder decoder) throws DecoderException {
+		if (!resultView || enhancedResult || resultTypes != null) {
+			throw new DecoderException("Unexpected result datatype prelude");
+		}
+		int root = decoder.openElement(ELEM_KUNA_RESULT);
+		if (decoder.readUnsignedInteger(ATTRIB_KUNA_RESULT_VERSION) != RESULT_VERSION) {
+			throw new DecoderException("Unsupported result datatype version");
+		}
+		Map<Long, ResultTypeDefinition> definitions = new LinkedHashMap<>();
+		boolean defining = false;
+		while (decoder.peekElement() != 0) {
+			if (decoder.peekElement() == ELEM_KUNA_TYPE.id() && !defining) {
+				ResultTypeNode reservation = readResultTypeNode(decoder);
+				ResultTypeDefinition definition = new ResultTypeDefinition();
+				definition.reservation = reservation;
+				if (reservation.local == 0 ||
+					definitions.putIfAbsent(reservation.local, definition) != null) {
+					throw new DecoderException("Duplicate or zero result datatype reservation");
+				}
+			}
+			else if (decoder.peekElement() == ELEM_KUNA_DEFINITION.id()) {
+				defining = true;
+				int element = decoder.openElement(ELEM_KUNA_DEFINITION);
+				long handle = decoder.readUnsignedInteger(ATTRIB_KUNA_LOCAL);
+				ResultTypeDefinition definition = definitions.get(handle);
+				if (definition == null || definition.body != null) {
+					throw new DecoderException("Unreserved or duplicate result datatype definition");
+				}
+				definition.body = readResultTypeNode(decoder);
+				decoder.closeElement(element);
+			}
+			else {
+				throw new DecoderException("Unexpected result datatype prelude element");
+			}
+		}
+		decoder.closeElement(root);
+		for (ResultTypeDefinition definition : definitions.values()) {
+			if (definition.body == null) {
+				throw new DecoderException("Missing result datatype definition");
+			}
+			ResultTypeNode reservation = definition.reservation;
+			String meta = definition.body.meta.isEmpty() ? reservation.meta : definition.body.meta;
+			String name = reservation.name.isEmpty() ? "kuna_type_" + reservation.local :
+				reservation.name;
+			if (definition.body.element == ELEM_QUALIFIED.id()) {
+				int qualifiers = Math.toIntExact(definition.body.value);
+				if (qualifiers == 0 || (qualifiers & ~7) != 0) {
+					throw new DecoderException("Invalid result datatype qualifiers");
+				}
+				definition.type = new ResultQualifiedDataType(name,
+					Undefined1DataType.dataType, qualifiers, progDataTypes);
+			}
+			else if (definition.body.element == ELEM_DEF.id()) {
+				definition.type = new TypedefDataType(CategoryPath.ROOT, name,
+					Undefined1DataType.dataType, progDataTypes);
+			}
+			else if (meta.equals("struct")) {
+				definition.type = new StructureDataType(CategoryPath.ROOT, name,
+					reservation.size, progDataTypes);
+			}
+			else if (meta.equals("union")) {
+				definition.type = new UnionDataType(CategoryPath.ROOT, name, progDataTypes);
+			}
+			else if (meta.equals("code") && definition.body.child(ELEM_PROTOTYPE.id()) != null) {
+				definition.type = new FunctionDefinitionDataType(CategoryPath.ROOT, name,
+					progDataTypes);
+			}
+			else if (meta.startsWith("enum_")) {
+				definition.type = new EnumDataType(CategoryPath.ROOT, name,
+					reservation.size, progDataTypes);
+			}
+		}
+		for (ResultTypeDefinition definition : definitions.values()) {
+			completeResultType(definition, definitions);
+		}
+		resultTypes = new LinkedHashMap<>();
+		resultReservations = new IdentityHashMap<>();
+		for (Map.Entry<Long, ResultTypeDefinition> entry : definitions.entrySet()) {
+			DataType type = entry.getValue().type;
+			resultTypes.put(entry.getKey(), type);
+			resultReservations.put(type, entry.getValue().reservation);
+		}
+		resultDataTypes = Collections.unmodifiableCollection(resultTypes.values());
+		enhancedResult = true; // An empty, versioned prelude also acknowledges admission.
+	}
