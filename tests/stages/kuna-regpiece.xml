<script>
  <com>map function r0x401000 xpipe</com>
  <com>map function r0x401020 mtf</com>
  <com>parse line extern int4 xpipe(int4 *p);</com>
  <com>parse line extern int4 mtf(int4 fd,int4 a,int4 b);</com>
  <com>map function r0x401030 sh_openpipe</com>
  <com>lo fu sh_openpipe</com>
  <com>decompile</com>
  <com>print C</com>
  <com>map function r0x401100 wide_return</com>
  <com>parse line extern int4 wide_return(int4 *p);</com>
  <com>map function r0x401120 piece_return</com>
  <com>parse line extern uint8 piece_return(int4 *p);</com>
  <com>lo fu piece_return</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="REGPIECE #1: the upper half of rax is a declared local" min="1" max="1">^  unsigned int v\d+; // register 0x4$</stringmatch>
<stringmatch name="REGPIECE #2: no global-looking register piece" min="0" max="0">dat_4</stringmatch>
