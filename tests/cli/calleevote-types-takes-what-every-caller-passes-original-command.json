{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "decompile-all",
    "{{BIN}}",
    "--option",
    "calleevote",
    "types"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 120,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/calleevote_x86_64",
    "binary_sha256": "87748df9fd521469bdb5a5bbd4ae3946ea8781c775fdea0b1c186d535bfd7648",
    "binary_size": 16176,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/calleevote_x86_64",
    "selector": "peek_used",
    "selector_kind": "name"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_matches": [
      "long peek_used\\(([A-Za-z_]\\w*) \\*(\\w+)\\)\\s*\\{\\s*(?://[^\\r\\n]*\\n\\s*)*return \\2->field_0x8 \\* 3;[\\s\\S]*long report\\(\\1 \\*\\w+\\)",
      "\\bsame\\(char \\*\\w+,char \\*\\w+\\)",
      "(?:unsigned )?long get_cap\\(void \\*\\w+\\)",
      "\\bby_used\\(void \\*\\w+,void \\*\\w+\\)",
      "void mark\\(void \\*(\\w+)\\)\\s*\\{\\s*(?://[^\\r\\n]*\\n\\s*)*\\(\\(unsigned int \\*\\)\\1\\)\\[1\\] = 0xffffffff;"
    ],
    "stdout_absent": [
      "\\b\\w+\\[4\\] = '"
    ]
  },
  "notes": "Original calleevote-types command, without callbacktype override: peek_used/report share a record, same takes strings, get_cap/by_used stay void pointers, and mark retains a word store at offset4. The source comparator is executed at O0/O2."
}
