{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "decompile",
    "{{BIN}}",
    "stack_aggregate"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 60,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/checker_stack_aggregate_x86_64",
    "binary_sha256": "92968f535eaaa3dbf064699e5fcbe1e65ddd6456aa7c46495b26e1d63b9a9160",
    "binary_size": 10808,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/checker_stack_aggregate_x86_64",
    "selector": "stack_aggregate",
    "selector_kind": "name"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_matches": [
      "u64 v12; // (?:[^|\\r\\n]+ \\| )*stack - 0x10(?: \\| [^|\\r\\n]+)*",
      "\\*\\(u32 \\*\\)&v12 = a;",
      "\\(\\(u32 \\*\\)&v12\\)\\[1\\] = b;",
      "sink\\(&v12\\);"
    ]
  },
  "notes": "DWARF maps one authored u64 local v12: its two u32 pieces and address reference share that name. Retain the eight-byte whole-object declaration, stores at offsets zero and four, and sink(&v12). The constant-only address reference is not a whole storage high and cannot suppress the piece accesses."
}
