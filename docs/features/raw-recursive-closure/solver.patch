+/// Borrowed only during one raw transfer. Never attached to a call or FD.
+pub(crate) struct RecursiveCalls<'a> {
+    pub calls: BTreeMap<OpId, RawCallView<'a>>,
+    reachable: BTreeSet<crate::context::BlockId>,
+    stopped_blocks: BTreeSet<crate::context::BlockId>,
+    stopped_calls: BTreeSet<OpId>,
+}
+
+impl RecursiveCalls<'_> {
+    pub(crate) fn block_reachable(&self, block: crate::context::BlockId) -> bool {
+        self.reachable.contains(&block)
+    }
+    pub(crate) fn block_continues(&self, block: crate::context::BlockId) -> bool {
+        self.reachable.contains(&block) && !self.stopped_blocks.contains(&block)
+    }
+    pub(crate) fn stops(&self, op: OpId) -> bool { self.stopped_calls.contains(&op) }
+}
