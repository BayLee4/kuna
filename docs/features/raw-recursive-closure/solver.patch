+            returns: ReturnView { definite_writes: &facts.definite_writes,
+                restored: &facts.restored, stack_adjustments: &facts.stack_adjustments },
+        })
+    }
+    pub(crate) fn definite_writes(&self) -> &'a [(Address, int4)] { self.returns.definite_writes }
+    pub(crate) fn restored(&self) -> &'a [(Address, int4)] { self.returns.restored }
+    pub(crate) fn stack_adjustments(&self) -> &'a [(Address, int4, i64)] { self.returns.stack_adjustments }
+    pub(crate) fn restores(&self, address: &Address, size: int4) -> bool {
+        covers(self.restored(), address, size)
+    }
+    pub(crate) fn is_bookkeeping(&self, address: &Address, size: int4) -> bool {
+        covers(self.bookkeeping, address, size)
+    }
+}
+
+fn covers(ranges: &[(Address, int4)], address: &Address, size: int4) -> bool {
+    let Some(end) = u64::try_from(size).ok().filter(|size| *size > 0)
+        .and_then(|size| address.get_offset().checked_add(size)) else { return false; };
+    let mut cursor = address.get_offset();
+    while cursor < end {
+        let next = ranges.iter().filter(|(at, size)| *size > 0
+            && at.get_space().zip(address.get_space()).is_some_and(|(a, b)| Rc::ptr_eq(a, b))
+            && at.get_offset() <= cursor)
+            .filter_map(|(at, size)| at.get_offset().checked_add(*size as u64)).max().unwrap_or(cursor);
+        if next <= cursor { return false; }
+        cursor = next.min(end);
+    }
+    true
+}
