+fn close_bookkeeping(members: &[&Funcdata], graphs: &[CapturedGraph], snapshots: &mut [RecursiveSnapshot],
+    external: &BTreeMap<Address, Rc<EntryRequirements>>)
+{
+    // Greatest candidate elimination is safe only after positive raw demand is fixed.
+    // Every retained candidate still passes the actual local-use and child-use test.
+    for (fd, snapshot) in members.iter().zip(snapshots.iter_mut()) {
+        snapshot.bookkeeping = stack_candidates(fd);
+        snapshot.bookkeeping.extend(return_bookkeeping_candidates(fd, &snapshot.reads, None)
+            .into_iter().map(|(range, _)| range));
+    }
+    loop {
+        let next = members.iter().enumerate().map(|(index, fd)| {
+            let calls = calls(&graphs[index], snapshots, external);
+            let lookup = |op| calls.calls.get(&op).copied();
+            let return_candidates = return_bookkeeping_candidates(fd, &snapshots[index].reads, None);
+            snapshots[index].bookkeeping.iter().filter(|(address, size)| {
+                if return_candidates.iter().any(|((at, bytes), value)| at == address && bytes == size
+                    && return_target_uses(fd, *value, &lookup, None, None)) { return true; }
+                let Some(tainted) = stack_address_uses(fd, address, *size, &lookup, None, None) else { return false; };
+                calls.calls.values().all(|call| call.reads.iter().all(|(at, bytes)| {
+                    let intersects = at.get_space().is_some_and(|space| tainted.iter().any(|(id, offset, size)|
+                        *id == space.get_index() && *offset < at.get_offset().saturating_add(*bytes as u64)
+                            && at.get_offset() < offset.saturating_add(*size as u64)));
+                    !intersects || call.is_bookkeeping(at, *bytes)
+                }))
+            }).cloned().collect::<Ranges>()
+        }).collect::<Vec<_>>();
+        let changed = snapshots.iter().zip(&next).any(|(snapshot, next)| snapshot.bookkeeping != *next);
+        for (snapshot, next) in snapshots.iter_mut().zip(next) { snapshot.bookkeeping = next; }
+        if !changed { break; }
+    }
+}
