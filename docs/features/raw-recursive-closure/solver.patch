+#[derive(Clone, PartialEq, Eq)]
+enum Target { Member(usize), External(Address) }
+
+#[derive(Clone, PartialEq, Eq)]
+struct CapturedGraph {
+    blocks: Vec<crate::context::BlockId>,
+    operations: Vec<Vec<OpId>>,
+    successors: Vec<Vec<crate::context::BlockId>>,
+    calls: BTreeMap<OpId, Target>,
+}
+
+fn capture(fd: &Funcdata, members: &BTreeMap<Address, usize>,
+    external: &BTreeMap<Address, Rc<EntryRequirements>>) -> Option<CapturedGraph>
+{
+    if fd.bblocks_get_size() == 0 || fd.has_unimplemented() || fd.has_bad_data() { return None; }
+    let blocks = (0..fd.bblocks_get_size()).map(|index| fd.bblocks_get_block(index)).collect::<Vec<_>>();
+    let positions = blocks.iter().copied().collect::<BTreeSet<_>>();
+    let mut result = CapturedGraph { blocks, operations: Vec::new(), successors: Vec::new(), calls: BTreeMap::new() };
+    for block in &result.blocks {
+        let basic = fd.bblocks_ref().block(*block);
+        let BlockKind::Basic(data) = basic.kind() else { return None; };
+        let successors = (0..basic.size_out()).map(|edge| basic.get_out(edge)).collect::<Vec<_>>();
+        if successors.iter().any(|next| !positions.contains(next)) { return None; }
+        let mut next = data.op_head;
+        let mut operations = Vec::new();
+        while let Some(op) = next {
+            let operation = fd.obank().get(op)?;
+            if operation.get_halt_type() != 0 { return None; }
+            let code = operation.code();
+            if matches!(code, OpCode::CPUI_CALLIND | OpCode::CPUI_CALLOTHER | OpCode::CPUI_BRANCHIND) { return None; }
+            if code == OpCode::CPUI_CALL {
+                let call = fd.get_call_specs(fd.get_call_specs_index(op)?);
+                let entry = call.get_entry_address();
+                let target = if let Some(index) = members.get(entry) { Target::Member(*index) }
+                    else {
+                        let facts = external.get(entry)?;
+                        if !facts.is_complete() { return None; }
+                        Target::External(entry.clone())
+                    };
+                result.calls.insert(op, target);
+            }
+            if matches!(code, OpCode::CPUI_LOAD | OpCode::CPUI_STORE) {
+                let memory = operation.get_in(0).and_then(|id| fd.vbank().get(id))
+                    .filter(|value| value.is_constant())
+                    .and_then(|value| int4::try_from(value.get_offset()).ok())
+                    .and_then(|index| fd.get_arch().manage().get_space(index))?;
+                if memory.get_name() == "register" { return None; }
+            }
+            operations.push(op);
+            next = operation.basic_neighbours().1;
+        }
+        let last = operations.last().and_then(|op| fd.obank().get(*op))?;
+        if successors.is_empty() && last.code() != OpCode::CPUI_RETURN { return None; }
+        result.operations.push(operations);
+        result.successors.push(successors);
+    }
+    Some(result)
+}
+
+fn calls<'a>(graph: &CapturedGraph, snapshots: &'a [RecursiveSnapshot],
+    external: &'a BTreeMap<Address, Rc<EntryRequirements>>) -> RecursiveCalls<'a>
+{
+    let calls = graph.calls.iter().map(|(op, target)| (*op, match target {
+        Target::Member(index) => RawCallView::snapshot(&snapshots[*index]),
+        Target::External(entry) => RawCallView::committed(&external[entry]).expect("captured complete external"),
+    })).collect::<BTreeMap<_, _>>();
+    let positions = graph.blocks.iter().enumerate().map(|(index, block)| (*block, index)).collect::<BTreeMap<_, _>>();
+    let mut result = RecursiveCalls { calls, reachable: BTreeSet::new(), stopped_blocks: BTreeSet::new(), stopped_calls: BTreeSet::new() };
+    let mut work = vec![0];
+    while let Some(index) = work.pop() {
+        let block = graph.blocks[index];
+        if !result.reachable.insert(block) { continue; }
+        if let Some(op) = graph.operations[index].iter().find(|op|
+            result.calls.get(op).is_some_and(|call| !call.has_finite_return()))
+        {
+            result.stopped_blocks.insert(block);
+            result.stopped_calls.insert(*op);
+        } else {
+            work.extend(graph.successors[index].iter().map(|block| positions[block]));
+        }
+    }
+    result
+}
+
+fn add_ranges(domain: &mut Vec<(int4, u64)>, ranges: &[(Address, int4)]) -> Option<()> {
+    for (address, size) in ranges {
+        let space = address.get_space()?;
+        let bytes = u64::try_from(*size).ok().filter(|size| *size > 0)?;
+        let end = address.get_offset().checked_add(bytes)?;
+        domain.extend((address.get_offset()..end).map(|offset| (space.get_index(), offset)));
+    }
+    Some(())
+}
+
+fn append_ranges(domain: &[(int4, u64)], ranges: &[(Address, int4)], events: &mut Vec<Access>, write: bool) {
+    for (address, size) in ranges {
+        let space = address.get_space().expect("validated raw range");
+        let start = domain.binary_search(&(space.get_index(), address.get_offset())).expect("raw domain contains range");
+        events.push(if write { Access::Write(start..start + *size as usize) }
+            else { Access::Read(start..start + *size as usize) });
+    }
+}
+
+fn local_accesses(fd: &Funcdata, graph: &CapturedGraph, domain: &[(int4, u64)],
+    returns: &[(Address, int4)], calls: &RecursiveCalls<'_>, demand: bool,
+) -> (Ranges, Ranges, bool)
+{
+    let events = graph.operations.iter().enumerate().map(|(index, operations)| {
+        let mut events = Vec::new();
+        if !calls.block_reachable(graph.blocks[index]) { return events; }
+        for op in operations {
+            let operation = fd.obank().get(*op).expect("captured raw operation");
+            if operation.code() == OpCode::CPUI_RETURN { append_ranges(domain, returns, &mut events, false); }
+            if demand {
+                if let Some(call) = calls.calls.get(op) { append_ranges(domain, call.reads, &mut events, false); }
+            }
+            append_register_reads(fd, *op, domain, &mut events);
+            if calls.stops(*op) { break; }
+            if let Some(call) = calls.calls.get(op) { append_ranges(domain, call.definite_writes(), &mut events, true); }
+            if let Some((space, offset, size)) = operation.get_out().and_then(|out| register_range(fd, out)) {
+                let start = domain.binary_search(&(space, offset)).expect("local output domain");
+                events.push(Access::Write(start..start + size));
+            }
+            if operation.code() == OpCode::CPUI_RETURN { events.push(Access::Return); }
+        }
+        events
+    }).collect::<Vec<_>>();
+    solve_register_accesses(fd, domain, &events, |block, _| calls.block_continues(block))
+}
+
+fn meet_ranges(previous: &[(Address, int4)], next: &[(Address, int4)]) -> Ranges {
+    let mut result = Vec::new();
+    for (address, size) in previous {
+        for byte in 0..*size {
+            let at = address + i64::from(byte);
+            if covers(next, &at, 1) { result.push((at, 1)); }
+        }
+    }
+    coalesce_writes(&mut result);
+    result
+}
+
+fn stack_candidates(fd: &Funcdata) -> Ranges {
+    let mut result = Vec::new();
+    if let Some(stack) = fd.get_arch().manage().get_stack_space() {
+        for index in 0..stack.num_spacebase() {
+            if let Ok(storage) = stack.get_spacebase(index) {
+                if let Some(space) = storage.space { result.push((Address::new(space, storage.offset), storage.size as int4)); }
+            }
+        }
+    }
+    result
+}
