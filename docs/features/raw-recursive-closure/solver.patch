+impl<'a> RawCallView<'a> {
+    pub(crate) fn committed(facts: &'a EntryRequirements) -> Option<Self> {
+        if !facts.is_complete() { return None; }
+        Some(Self {
+            reads: &facts.reads, writes: &facts.writes,
+            reads_memory: facts.reads_memory, writes_memory: facts.writes_memory,
+            bookkeeping: &facts.bookkeeping,
+            returns: facts.has_normal_return.then_some(ReturnView { definite_writes: &facts.definite_writes,
+                restored: &facts.restored, stack_adjustments: &facts.stack_adjustments }),
+        })
+    }
+
+    fn snapshot(facts: &'a RecursiveSnapshot) -> Self {
+        Self {
+            reads: &facts.reads, writes: &facts.may.writes,
+            reads_memory: facts.may.reads_memory, writes_memory: facts.may.writes_memory,
+            bookkeeping: &facts.bookkeeping,
+            returns: match &facts.returns {
+                FiniteReturns::NoFiniteReturn => None,
+                FiniteReturns::Returning(returns) => Some(ReturnView {
+                    definite_writes: &returns.definite_writes, restored: &returns.restored,
+                    stack_adjustments: &returns.stack_adjustments,
+                }),
+            },
+        }
+    }
+
+    pub(crate) fn has_finite_return(&self) -> bool { self.returns.is_some() }
+    pub(crate) fn transfer_facts(&self) -> Option<RawTransferFacts<'a>> {
+        Some(RawTransferFacts {
+            reads: self.reads, writes: self.writes,
+            reads_memory: self.reads_memory, writes_memory: self.writes_memory,
+            bookkeeping: self.bookkeeping, returns: self.returns?,
+        })
+    }
+    pub(crate) fn definite_writes(&self) -> &'a [(Address, int4)] {
+        self.returns.map_or(&[], |returns| returns.definite_writes)
+    }
+    pub(crate) fn restored(&self) -> &'a [(Address, int4)] {
+        self.returns.map_or(&[], |returns| returns.restored)
+    }
+    pub(crate) fn stack_adjustments(&self) -> &'a [(Address, int4, i64)] {
+        self.returns.map_or(&[], |returns| returns.stack_adjustments)
+    }
+    pub(crate) fn restores(&self, address: &Address, size: int4) -> bool {
+        covers(self.restored(), address, size)
+    }
+    pub(crate) fn is_bookkeeping(&self, address: &Address, size: int4) -> bool {
+        covers(self.bookkeeping, address, size)
+    }
+}
