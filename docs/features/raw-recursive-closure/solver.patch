+fn raw_has_finite_return(fd: &Funcdata, callees: &BTreeMap<OpId, Rc<EntryRequirements>>) -> bool {
+    if fd.bblocks_get_size() == 0 { return false; }
+    let mut visited = BTreeSet::new();
+    let mut work = vec![fd.bblocks_get_block(0)];
+    while let Some(block) = work.pop() {
+        if !visited.insert(block) { continue; }
+        let mut next = fd.bb_op_head(block);
+        let mut stopped = false;
+        while let Some(op) = next {
+            let operation = fd.obank().get(op).expect("live raw return path");
+            if operation.code() == OpCode::CPUI_RETURN && operation.get_halt_type() == 0 { return true; }
+            if callees.get(&op).is_some_and(|child| !child.has_normal_return) {
+                stopped = true;
+                break;
+            }
+            next = fd.bb_op_next(op);
+        }
+        if !stopped {
+            let basic = fd.bblocks_ref().block(block);
+            work.extend((0..basic.size_out()).map(|edge| basic.get_out(edge)));
+        }
+    }
+    false
+}
