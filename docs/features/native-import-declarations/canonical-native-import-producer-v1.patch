+@@ -0,0 +1,54 @@
++package ghidra.program.model.pcode;
++
++import java.io.IOException;
++
++import ghidra.program.model.listing.Function;
++import ghidra.program.model.listing.Library;
++import ghidra.program.model.listing.Program;
++import ghidra.program.model.symbol.ExternalLocation;
++import ghidra.program.model.symbol.SourceType;
++
++/** Exact imported provider identity; never canonical C text or a body waiver. */
++final class KunaNativeImport {
++    private static final AttributeId LIBRARY = new AttributeId("kuna_import_library", 4050);
++    private static final AttributeId SYMBOL = new AttributeId("kuna_import_symbol", 4051);
++    private static final AttributeId PLATFORM = new AttributeId("kuna_import_platform", 4052);
++    private static final AttributeId ID = new AttributeId("kuna_import_id", 4053);
++
++    private KunaNativeImport() { }
++
++    static void encode(Encoder encoder, Function function) throws IOException {
++        Program program = function.getProgram();
++        Function external = function.isThunk() ? function.getThunkedFunction(true) : function;
++        if (external == null || !external.isExternal()) {
++            return;
++        }
++        ExternalLocation location = program.getExternalManager().getExternalLocation(external.getSymbol());
++        if (location == null || location.getSource() != SourceType.IMPORTED ||
++            location.getSymbol() == null || location.getSymbol().getID() <= 0 ||
++            Library.UNKNOWN.equals(location.getLibraryName())) {
++            return;
++        }
++        String platform = switch (program.getExecutableFormat()) {
++            case "Mac OS X Mach-O" -> "macho";
++            case "Executable and Linking Format (ELF)" -> "elf";
++            case "Portable Executable (PE)" -> "pe";
++            default -> null;
++        };
++        if (platform == null) {
++            return;
++        }
++        String symbol = location.getOriginalImportedName();
++        if (symbol == null) {
++            symbol = location.getLabel();
++        }
++        String library = location.getLibraryName();
++        if (library == null || library.isEmpty() || symbol == null || symbol.isEmpty()) {
++            return;
++        }
++        encoder.writeString(LIBRARY, library);
++        encoder.writeString(SYMBOL, symbol);
++        encoder.writeString(PLATFORM, platform);
++        encoder.writeUnsignedInteger(ID, location.getSymbol().getID());
++    }
++}
