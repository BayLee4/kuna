+//! Source-C declarations attached to exact imported library identities.
+//! Recovered source datatypes remain unchanged; these facts are not raw effects.
+
+use crate::dtype::{type_metatype, TypeRoot};
+use crate::fspec::FuncProto;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ImportPlatform { Elf, MachO, Pe }
+
+impl ImportPlatform {
+    pub fn wire_name(self) -> &'static str {
+        match self { Self::Elf => "elf", Self::MachO => "macho", Self::Pe => "pe" }
+    }
+
+    pub fn from_wire(value: &str) -> Option<Self> {
+        match value { "elf" => Some(Self::Elf), "macho" => Some(Self::MachO), "pe" => Some(Self::Pe), _ => None }
+    }
+}
+
+/// Loader/host-owned identity at one concrete imported entry. Never created by
+/// a by-name prototype model, a local definition, or a user function-name hint.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct NativeImportIdentity {
+    pub platform: ImportPlatform,
+    pub library: String,
+    pub symbol: String,
+}
+
+/// The erased ABI of these measured declarations is the existing single-format
+/// variadic model. The canonical declaration independently retains pointee const.
+/// glibc __isoc99_scanf is its real exported symbol, not a renamed scanf call.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct CanonicalNativeDeclaration {
+    pub c_name: &'static str,
+    pub model_key: &'static str,
+}
+
+impl CanonicalNativeDeclaration {
+    pub fn declaration(self) -> String {
+        format!("int {}(const char *p0, ...)", self.c_name)
+    }
+}
+
+fn primitive(ty: &TypeRoot, names: &[&str], size: i32, metas: &[type_metatype]) -> bool {
+    let view = ty.read();
+    let Ok(id) = view.resolve_alias(ty.id()) else { return false };
+    let Ok(node) = view.get(id) else { return false };
+    node.get_size() == size && metas.contains(&node.get_metatype()) && names.contains(&node.get_name())
+}
+
+/// Canonical library knowledge exists only for these exact imported bindings.
+pub fn known_declaration(identity: &NativeImportIdentity) -> Option<CanonicalNativeDeclaration> {
+    let (c_name, model_key) = match (identity.platform, identity.library.as_str(), identity.symbol.as_str()) {
+        (ImportPlatform::MachO, "/usr/lib/libSystem.B.dylib", "_printf") => ("printf", "darwin-system-printf"),
+        (ImportPlatform::MachO, "/usr/lib/libSystem.B.dylib", "_scanf") => ("scanf", "darwin-system-scanf"),
+        (ImportPlatform::Elf, "libc.so.6", "printf") => ("printf", "glibc-printf"),
+        (ImportPlatform::Elf, "libc.so.6", "scanf") => ("scanf", "glibc-scanf"),
+        (ImportPlatform::Elf, "libc.so.6", "__isoc99_scanf") => ("__isoc99_scanf", "glibc-isoc99-scanf"),
+        (ImportPlatform::Pe, library, "printf") if library.eq_ignore_ascii_case("msvcrt.dll") => ("printf", "msvcrt-printf"),
+        (ImportPlatform::Pe, library, "scanf") if library.eq_ignore_ascii_case("msvcrt.dll") => ("scanf", "msvcrt-scanf"),
+        (ImportPlatform::Pe, library, "printf") if library.eq_ignore_ascii_case("ucrtbase.dll") => ("printf", "ucrt-printf"),
+        (ImportPlatform::Pe, library, "scanf") if library.eq_ignore_ascii_case("ucrtbase.dll") => ("scanf", "ucrt-scanf"),
+        _ => return None,
+    };
+    Some(CanonicalNativeDeclaration { c_name, model_key })
+}
+
+/// This matches canonical source shape only. The caller must additionally prove
+/// the actual default native calling model and invocation ABI. Neither an import
+/// name alone nor an ABI-compatible user edit grants canonical source authority.
+pub fn canonical_declaration(identity: &NativeImportIdentity, current_name: &str,
+    proto: &FuncProto, pointer_size: i32) -> Option<CanonicalNativeDeclaration>
+{
+    let descriptor = known_declaration(identity)?;
+    let c_name = descriptor.c_name;
+    // Mach-O's single leading underscore is the known platform C decoration,
+    // not a general rename rule; current arbitrary host labels remain untouched.
+    if current_name != identity.symbol && current_name != c_name { return None; }
+    if !proto.has_store() || !proto.is_input_locked() || !proto.is_output_locked()
+        || proto.has_custom_storage() || !proto.is_dotdotdot() || proto.num_params() != 1
+        || proto.get_abi_first_vararg() != 1 || proto.has_this_pointer()
+        || proto.is_constructor() || proto.is_destructor() { return None; }
+    let output = proto.get_output().get_type()?;
+    if !primitive(output, &["int", "int4"], 4, &[type_metatype::TYPE_INT]) { return None; }
+    let input = proto.get_param(0)?.get_type()?;
+    if input.get_metatype() != type_metatype::TYPE_PTR || input.get_size() != pointer_size { return None; }
+    let pointed = input.get_ptr_to()?;
+    if !primitive(&pointed, &["char"], 1, &[type_metatype::TYPE_INT, type_metatype::TYPE_UINT]) { return None; }
+    Some(descriptor)
+}
