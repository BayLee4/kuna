+/// Canonical C spelling is independent of the retained, qualifier-erased source
+/// graph. Only a genuine imported target and its current complete native ABI
+/// can select a standard-library descriptor.
+pub(crate) fn canonical_native_import(fd: &Funcdata, entry: &Address, name: &str)
+    -> KunaResult<Option<crate::kuna_nativeimport::CanonicalNativeDeclaration>>
+{
+    let Some(identity) = fd.get_arch().native_import_at(entry) else { return Ok(None) };
+    let Some((current_name, target, prototype)) = fd.get_arch().query_function(entry)? else { return Ok(None) };
+    if target != *entry || name != current_name || !native_default_model(&prototype, fd) { return Ok(None); }
+    let Some(types) = fd.get_arch().types() else { return Ok(None) };
+    Ok(crate::kuna_nativeimport::canonical_declaration(&identity, name, &prototype, types.get_size_of_pointer()))
+}
